{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tagteam project configuration, version 6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "base", "branchPrefix", "conventionsPath", "models", "effort",
    "reviewers", "verify", "ciWaitSec", "autoMerge", "worktree", "reviewExclude",
    "maxConcurrentCodex"
  ],
  "properties": {
    "version": { "const": 6, "type": "integer" },
    "base": {
      "type": "string",
      "minLength": 1,
      "description": "The branch pull requests target and each spec branches from."
    },
    "branchPrefix": {
      "type": "string",
      "minLength": 1,
      "description": "Prefix for generated branches, e.g. tagteam/."
    },
    "conventionsPath": {
      "type": ["string", "null"],
      "description": "A repository document implementers and reviewers are told to read. Null when there is none."
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lead", "worker", "codex"],
      "properties": {
        "lead": { "$ref": "#/$defs/claudeModel" },
        "worker": { "$ref": "#/$defs/claudeModel" },
        "codex": { "type": "string", "minLength": 1 }
      }
    },
    "effort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lead", "worker", "codex"],
      "properties": {
        "lead": { "$ref": "#/$defs/claudeEffort" },
        "worker": { "$ref": "#/$defs/claudeEffort" },
        "codex": { "type": "string", "enum": ["low", "medium", "high", "xhigh"] }
      }
    },
    "reviewers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roster", "default"],
      "properties": {
        "roster": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "description": "Every lens a plan may assign to a spec."
        },
        "default": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "description": "Lenses applied to every spec unless that spec removes one. A Codex cross-review and the adversary run in addition, always."
        }
      }
    },
    "verify": {
      "type": "array",
      "description": "Commands proving a candidate works. Zero matching commands is reported as not-applicable and waits for a person rather than passing.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "when", "timeoutSec"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "when": {
            "type": "object",
            "additionalProperties": false,
            "required": ["globs", "keywords"],
            "properties": {
              "globs": { "type": "array", "items": { "type": "string" } },
              "keywords": { "type": "array", "items": { "type": "string" } }
            },
            "description": "Empty globs and empty keywords mean the command always runs."
          },
          "timeoutSec": { "type": "integer", "minimum": 1, "maximum": 7200 }
        }
      }
    },
    "ciWaitSec": {
      "type": "integer",
      "minimum": 0,
      "maximum": 21600,
      "description": "How long to wait for GitHub checks. Still pending at the deadline counts as not-run, which waits for a person. Zero skips CI entirely."
    },
    "autoMerge": {
      "type": "boolean",
      "description": "When false every pull request waits for approval, whatever the gates say."
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setup", "copyUntracked", "setupTimeoutSec"],
      "properties": {
        "setup": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Commands making a fresh worktree buildable, e.g. npm ci."
        },
        "copyUntracked": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ignored files a build needs, e.g. .env.test. Each must be ignored at its destination or the copy is refused."
        },
        "setupTimeoutSec": { "type": "integer", "minimum": 1, "maximum": 7200 }
      }
    },
    "reviewExclude": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Globs whose contents are summarised rather than included in the review diff — lock files, snapshots, generated code."
    },
    "maxConcurrentCodex": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "description": "How many Codex calls may run at once across this repository."
    }
  },
  "$defs": {
    "claudeModel": { "type": "string", "enum": ["opus", "fable", "sonnet"] },
    "claudeEffort": { "type": "string", "enum": ["low", "medium", "high", "xhigh", "max"] }
  }
}
