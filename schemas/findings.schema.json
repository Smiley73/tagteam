{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "dimension_sweep", "load_bearing_claim", "findings"],
  "properties": {
    "verdict": { "type": "string", "enum": ["clean", "needs-attention"] },
    "summary": { "type": "string", "minLength": 1 },
    "dimension_sweep": { "type": "string", "minLength": 1 },
    "load_bearing_claim": { "type": "string", "minLength": 1 },
    "specialist_decisions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]+$" },
          "decision": { "type": "string", "enum": ["adopt", "reject"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title", "body", "file", "line_start", "line_end", "severity",
          "dimension", "confidence", "recommendation"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "severity": { "type": "string", "enum": ["blocking", "major", "minor", "nit"] },
          "dimension": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "recommendation": { "type": "string", "minLength": 1 },
          "runtime_extension": { "type": "boolean", "default": false },
          "source_rule": { "type": "string" }
        }
      }
    }
  }
}
