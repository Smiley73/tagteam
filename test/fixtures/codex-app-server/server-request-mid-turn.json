            ],
            "thread": {
              "id": "thread-1"
            }
          }
        }
      ]
    },
    {
      "on": "turn/start",
      "send": [
        {
          "result": {
            "turn": {
              "id": "turn-1"
            }
          }
        },
        {
          "$raw": "this line is not JSON"
        },
        {
