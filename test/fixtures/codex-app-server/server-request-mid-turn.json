              "message": "Reconnecting... 1/5",
              "codexErrorInfo": "other",
              "additionalDetails": null
            },
            "willRetry": true
          }
        },
        {
          "id": "approval-1",
          "method": "item/commandExecution/requestApproval",
          "params": {}
        }
      ]
    },
    {
      "on": "$response",
      "send": [
        {
          "method": "turn/completed",
          "params": {
            "turn": {
              "id": "turn-1",
              "status": "completed",
              "items": [
                {
                  "type": "agentMessage",
                  "text": "{\"ok\":true}",
                  "phase": "final_answer"
                }
              ],
              "error": null
            }
          }
        }
      ]
    },
    {
      "on": "thread/read",
      "send": [
        {
          "result": {
            "thread": {
              "model": "gpt-5.6-sol",
              "reasoningEffort": "low",
              "cliVersion": "0.163.0-alpha.10.2"
            }
          }
        }
      ]
    }
  ]
}
