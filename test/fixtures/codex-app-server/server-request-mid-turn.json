{
  "synthetic": true,
  "capturedOn": "codex-cli 0.163.0-alpha.10.2",
  "scenario": "server-request-mid-turn",
  "description": "Synthetic, written by hand from the success capture: mid-turn the server sends a line that is not JSON, an error it will retry, and an approval request; the turn completes once the client has answered the request.",
  "steps": [
    {
      "on": "initialize",
      "send": [
        {
          "result": {}
        }
      ]
    },
    {
      "on": "thread/start",
      "send": [
        {
          "result": {
            "approvalPolicy": "never",
            "sandbox": {
              "type": "readOnly",
              "networkAccess": false
            },
            "instructionSources": [
