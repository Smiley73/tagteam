{
  "version": 9,
  "base": "main",
  "branchPrefix": "tagteam/",
  "conventionsPath": "CONTRIBUTING.md",
  "models": {
    "lead": "opus",
    "worker": "sonnet",
    "codex": "gpt-5.6-sol"
  },
  "effort": {
    "implementer": "high",
    "fixer": "high",
    "reviewer": "medium",
    "recheck": "low",
    "adversary": "high",
    "planner": "high",
    "codex": "high"
  },
  "reviewers": {
    "roster": [
      "correctness",
      "resilience",
      "security",
      "architecture",
      "code-quality",
      "experience",
      "consistency",
      "cost"
    ],
    "default": ["correctness", "code-quality"]
  },
  "verify": [
    {
      "command": "npm test",
      "when": { "globs": [], "keywords": [] },
      "timeoutSec": 900
    },
    {
      "command": "npm run lint",
      "when": { "globs": ["**/*.ts", "**/*.tsx", "**/*.js"], "keywords": [] },
      "timeoutSec": 300
    }
  ],
  "ciWaitSec": 1800,
  "autoMerge": true,
  "worktree": {
    "setup": ["npm ci"],
    "copyUntracked": [],
    "setupTimeoutSec": 900
  },
  "reviewExclude": [
    "package-lock.json",
    "pnpm-lock.yaml",
    "**/*.snap",
    "**/__snapshots__/**"
  ],
  "maxConcurrentCodex": 3,
  "limits": {
    "fixRounds": 1,
    "ciRepairs": 1
  },
  "escalation": null,
  "plan": null
}
