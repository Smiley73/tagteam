{
  "version": 2,
  "planning": {
    "claude": { "model": "opus", "effort": "xhigh" },
    "codex": { "model": "gpt-5.6-sol", "effort": "high" },
    "reviewRounds": 2,
    "largePlanWarningChars": 100000
  },
  "prTrain": {
    "enabled": true,
    "base": null,
    "mode": "github-pr",
    "prSize": { "guidance": "~400 changed lines", "enforce": false },
    "branchPrefix": "tagteam/",
    "mergeStrategy": "squash",
    "pauseOn": ["ui"],
    "ci": { "blockOnFailure": true, "waitTimeoutSec": 1800 }
  },
  "ui": {
    "gateOnUserVisible": true,
    "hasUserInterface": true,
    "conventionPaths": ["docs/ui-conventions.md"],
    "confirmDecisions": "new-surfaces"
  },
  "codegraph": { "enabled": true },
  "maxReviewLoops": 3,
  "reviewTiers": {
    "deep": {
      "claude": { "model": "opus", "effort": "xhigh" },
      "codex": { "model": "gpt-5.6-sol", "effort": "high" }
    },
    "standard": {
      "claude": { "model": "opus", "effort": "medium" },
      "codex": { "model": "gpt-5.6-sol", "effort": "medium" }
    },
    "light": {
      "claude": { "model": "opus", "effort": "low" },
      "codex": { "model": "gpt-5.6-sol", "effort": "low" }
    }
  },
  "reviewers": {
    "functionality": { "enabled": true, "tier": "deep" },
    "security": { "enabled": true, "tier": "deep", "gate": "blocking" },
    "code-quality": { "enabled": true, "tier": "standard" },
    "error-handling": { "enabled": true, "tier": "standard" },
    "test-coverage": { "enabled": true, "tier": "standard" },
    "concurrency": {
      "enabled": true,
      "tier": "deep",
      "when": {
        "globs": ["**/*.{go,rs,java,kt,swift}", "**/migrations/**", "**/*.sql", "**/schema*", "**/*repository*", "**/*dao*"],
        "keywords": ["async", "await", "mutex", "lock", "transaction", "goroutine", "thread", "actor", "@MainActor", "upsert", "migrate"]
      }
    },
    "reliability": {
      "enabled": true,
      "tier": "standard",
      "when": {
        "globs": ["**/*.{tf,yaml,yml}", "infrastructure/**", "**/*retry*", "**/*queue*", "**/*client*"],
        "keywords": ["retry", "timeout", "backoff", "circuit", "fallback", "catch", "reconnect"]
      }
    },
    "resiliency": {
      "enabled": true,
      "tier": "standard",
      "when": {
        "globs": ["infrastructure/**", "**/*.{tf,yaml,yml}", "**/*health*"],
        "keywords": ["retry", "timeout", "degrade", "failover", "healthcheck", "rollback"]
      }
    },
    "performance": {
      "enabled": true,
      "tier": "standard",
      "when": {
        "globs": ["**/*.sql", "**/migrations/**", "**/*query*", "**/*index*"],
        "keywords": ["forEach", "map(", "filter(", "await", "query", "fetch", "SELECT", "JOIN", "O(n"]
      }
    },
    "cost": {
      "enabled": true,
      "tier": "standard",
      "when": {
        "globs": ["**/*.tf", "infrastructure/**", "**/*prompt*", "**/*.sql"],
        "keywords": ["forEach", "map(", "await", "query", "fetch", "model:", "max_tokens"]
      }
    },
    "conventions": {
      "enabled": true,
      "tier": "standard",
      "when": {
        "globs": ["**/CODING_STANDARDS.md", "**/CLAUDE.md", "**/AGENTS.md", "**/.eslintrc*", "eslint.config.*", "**/*.{ts,tsx,js,swift,go}"]
      }
    },
    "documentation": {
      "enabled": true,
      "tier": "light",
      "when": {
        "globs": ["**/*.md", "**/*.mdx", "**/docs/**", "**/*.{ts,tsx,go,swift}"],
        "keywords": ["@param", "@returns", "///", "/**", "TODO", "README"]
      }
    },
    "accessibility": {
      "enabled": true,
      "tier": "light",
      "when": {
        "globs": ["src/components/**", "apps/*/src/**", "**/*.{tsx,jsx,vue,svelte,html,css}", "**/*View.swift", "**/*Screen*"]
      }
    }
  },
  "specialistPrepass": {
    "enabled": true,
    "claude": { "model": "opus", "effort": "medium" }
  },
  "complexity": {
    "simple": {
      "claude": { "model": "haiku", "effort": "medium" },
      "codex": { "model": "gpt-5.6-sol", "effort": "low" }
    },
    "medium": {
      "claude": { "model": "sonnet", "effort": "high" },
      "codex": { "model": "gpt-5.6-sol", "effort": "medium" }
    },
    "complex": {
      "claude": { "model": "opus", "effort": "xhigh" },
      "codex": { "model": "gpt-5.6-sol", "effort": "high" }
    }
  },
  "implementation": { "engine": "claude", "routes": [], "maxParallel": 1 },
  "review": { "firstReviewer": "codex" },
  "verify": {
    "runAfter": ["implement", "fix"],
    "commands": [
      { "when": { "globs": ["**/*"] }, "command": "npm test", "timeoutSec": 600 }
    ]
  },
  "worktree": { "setupCommands": [], "copyUntracked": [], "setupTimeoutSec": 1800 },
  "diffExclude": ["**/*.pbxproj", "**/pnpm-lock.yaml", "**/package-lock.json", "**/*.lock", "**/generated/**"],
  "transport": { "mode": "exec", "relayModel": "sonnet" },
  "limits": {
    "agentCallsPerPr": 60,
    "maxConcurrentCodex": 3
  }
}
