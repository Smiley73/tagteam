{
  "version": 5,
  "base": "main",
  "branchPrefix": "tagteam/",
  "conventionsPath": "CONTRIBUTING.md",
  "models": {
    "plan": "opus",
    "implement": "sonnet",
    "review": "opus",
    "codex": "gpt-5.6-sol"
  },
  "effort": {
    "plan": "high",
    "implement": "high",
    "review": "high",
    "codex": "high"
  },
  "reviewers": {
    "roster": [
      "correctness",
      "security",
      "error-handling",
      "test-coverage",
      "performance",
      "accessibility",
      "ux",
      "data-integrity",
      "conventions",
      "docs"
    ],
    "default": ["correctness", "test-coverage"]
  },
  "verify": [
    {
      "command": "npm test",
      "when": { "globs": [], "keywords": [] },
      "timeoutSec": 900
    },
    {
      "command": "npm run lint",
      "when": { "globs": ["**/*.ts", "**/*.tsx", "**/*.js"], "keywords": [] },
      "timeoutSec": 300
    }
  ],
  "ciWaitSec": 1800,
  "autoMerge": true,
  "worktree": {
    "setup": ["npm ci"],
    "copyUntracked": [],
    "setupTimeoutSec": 900
  },
  "reviewExclude": [
    "package-lock.json",
    "pnpm-lock.yaml",
    "**/*.snap",
    "**/__snapshots__/**"
  ],
  "maxConcurrentCodex": 3
}
